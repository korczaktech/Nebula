estrutura Conta: {
    nome: texto
    idade: inteiro

}

enumeracao Estado: {
    Inativo
    Ativo
    Falha(texto)

}

variavel conta = Conta { nome: "Lia", idade: 20 }
variavel estado = Estado::Ativo
variavel opcional = Opcional::Algum(42)
variavel resultado = Resultado::Sucesso(42)
variavel par = (42, "Nebula")
variavel vetor: Vetor<inteiro> = [1, 2]
variavel matriz: Matriz<inteiro> = [[1, 2], [3, 4]]
