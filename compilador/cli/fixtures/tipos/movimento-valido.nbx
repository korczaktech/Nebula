estrutura Conta:
    nome: texto
    idade: inteiro
fim
variavel conta = Conta { nome: "Lia", idade: 20, fim }
variavel nome = conta.nome
exibir(conta.idade)
variavel par = ("Lia", 20)
variavel pessoa = par[0]
exibir(par[1])
variavel nomes = ["Lia", "Bia"]
variavel nome_lista = nomes[0]
exibir(nomes[1])
